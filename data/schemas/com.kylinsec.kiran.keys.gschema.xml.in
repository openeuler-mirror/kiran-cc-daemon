<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@PROJECT_NAME@">
  <schema id="com.kylinsec.kiran.keys" path="/com/kylinsec/kiran/keys/">
    <key name="volume-step" type="i">
      <default>6</default>
      <summary>Volume step</summary>
      <description>Volume step as percentage of volume.</description>
    </key>
    <key name="power" type="s">
      <default>'Ctrl+Alt+Delete'</default>
      <summary>Shut down</summary>
      <description>Binding to shut down.</description>
    </key>
    <key name="logout" type="s">
      <default>''</default>
      <summary>Log out</summary>
      <description>Binding to log out.</description>
    </key>
    <key name="home" type="s">
      <default>'Meta+E'</default>
      <summary>Home folder</summary>
      <description>Binding to open the Home folder.</description>
    </key>
    <key name="email" type="s">
      <default>''</default>
      <summary>Launch email client</summary>
      <description>Binding to launch the email client.</description>
    </key>
    <key name="screensaver" type="s">
      <default>'Meta+L'</default>
      <summary>Lock screen</summary>
      <description>Binding to lock the screen.</description>
    </key>
    <key name="show-desktop" type="s">
      <default>'Meta+D'</default>
      <summary>Show desktop</summary>
      <description>Binding to show the desktop.</description>
    </key>
    <key name="help" type="s">
      <default>''</default>
      <summary>Launch help browser</summary>
      <description>Binding to launch the help browser.</description>
    </key>
    <key name="window-screenshot" type="s">
      <default>''</default>
      <summary>Window screenshot</summary>
      <description>Binding to take a screenshot of the current window.</description>
    </key>
    <key name="fullscreen-screenshot" type="s">
      <default>'Print'</default>
      <summary>Fullscreen screenshot</summary>
      <description>Binding to take a screenshot of the entire screen.</description>
    </key>
    <key name="area-screenshot" type="s">
      <default>'Ctrl+Shift+A'</default>
      <summary>Area screenshot</summary>
      <description>Binding to take a screenshot of a selected area.</description>
    </key>
    <key name="window-screenshot-command" type="s">
      <default>'kiran-flameshot window'</default>
      <summary>Window screenshot command</summary>
      <description>Command to take a screenshot of the current window.</description>
    </key>
    <key name="fullscreen-screenshot-command" type="s">
      <default>'kiran-flameshot full'</default>
      <summary>Fullscreen screenshot command</summary>
      <description>Command to take a screenshot of the entire screen.</description>
    </key>
    <key name="area-screenshot-command" type="s">
      <default>'kiran-flameshot gui'</default>
      <summary>Area screenshot command</summary>
      <description>Command to take a screenshot of a selected area.</description>
    </key>
  </schema>
</schemalist>
